generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String?
  avatar             String?
  googleId           String?  @unique
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  matches            Match[]
  boardStateDrafts   BoardStateDraft[]
}

model Match {
  id        Int      @id @default(autoincrement())
  userId    Int?
  placement Int // 1-8 rank in that game
  playedAt  DateTime @default(now()) // date/time of the match
  comp      String? // optional label for team comp (e.g., "Reroll Kayle")
  version   String? // game patch version (e.g., "18.1", "18.2")
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds           Round[] // Relation: Match has many Rounds
  boardStateDrafts BoardStateDraft[]
}

model Round {
  id          Int   @id @default(autoincrement())
  matchId     Int // foreign key pointing to Match
  stage       Int // e.g., 3
  roundNumber Int // e.g., 5
  gold        Int // gold at that round
  hp          Int // health at that round
  level       Int // board level
  streak      Int // win/loss streak count
  // Relation: Round belongs to Match
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  boardStateDrafts BoardStateDraft[]
  // Uncomment when you create the RoundChampion model:
  // roundChampions RoundChampion[]
}

model BoardStateDraft {
  id                 Int      @id @default(autoincrement())
  userId             Int
  matchId            Int?
  roundId            Int?
  screenshotFilename String
  originalFilename   String
  storagePath        String
  status             String   @default("uploaded")
  boardState         Json?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match              Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  round              Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([matchId])
  @@index([roundId])
}
